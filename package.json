{
  "name": "hasm-top",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync:logo": "node scripts/sync-logo.mjs",
    "sync:markdown-design": "node scripts/sync-markdown-design.mjs",
    "sync:visualizer": "node scripts/sync-hasm-visualizer.mjs",
    "sync:downloads": "node scripts/stage-downloads.mjs",
    "sync": "npm run sync:logo && npm run sync:markdown-design && npm run sync:visualizer && npm run sync:downloads",
    "build:hasm": "cd submodules/hasm && npm run build",
    "build:hasm-markdown": "cd submodules/hasm_markdown && npm run build",
    "build:all": "npm run build:hasm-markdown && npm run build:hasm && npm run build",
    "predev": "npm run sync",
    "dev": "vite",
    "prebuild": "npm run sync",
    "build": "vite build",
    "check:site": "node scripts/check-site.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "framer-motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2"
  }
}
