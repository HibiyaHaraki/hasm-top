# Normalize all text files to LF in the repository, regardless of the
# checkout platform's core.autocrlf setting.
* text=auto eol=lf

# Explicit text sources
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mdx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.gitmodules text eol=lf

# Binary assets must never be diffed/normalized
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
